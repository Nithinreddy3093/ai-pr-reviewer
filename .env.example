# Copy this file to .env and fill in real values. Never commit .env itself.

# --- GitHub ---
# Personal Access Token with 'repo' scope (or a GitHub App token if you upgrade later)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Secret you set when creating the webhook in your repo's Settings > Webhooks
# Must match exactly what you type into GitHub's "Secret" field
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Server ---
PORT=3000

# Diffs larger than this many changed lines get flagged as "large" and get a
# more careful, structured review instead of the quick pass. Tune as you like.
LARGE_DIFF_THRESHOLD=300
